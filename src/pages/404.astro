---
// 404 — serves with HTTP 404 on Cloudflare Pages (dist/404.html)
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found — Low Quality Image Maker" description="The page you are looking for does not exist. Return to the free low quality image maker.">
  <main class="max-w-2xl mx-auto px-4 min-h-dvh flex flex-col items-center justify-center text-center">
    <p class="text-brand-700 font-mono text-sm uppercase tracking-widest">Error 404</p>
    <h1 class="mt-3 text-4xl md:text-5xl font-bold tracking-tighter text-zinc-900">This page got deep fried</h1>
    <p class="mt-4 text-zinc-600">The page you are looking for doesn't exist or was moved.</p>
    <a href="/" class="mt-8 inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-brand-500 text-zinc-900 font-medium text-sm hover:bg-brand-600 transition-colors no-underline">
      Back to the image maker &rarr;
    </a>
  </main>
</BaseLayout>
