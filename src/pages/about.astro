---
// About — author identity & contact (E-E-A-T trust signal)
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'About Low Quality Image Maker — Who We Are';
const description = 'Low Quality Image Maker is built and maintained by Jiusong, a frontend developer. Learn who is behind the tool, why it exists, and how to contact us directly.';
---
<BaseLayout {title} {description}>
  <nav class="sticky top-0 z-50 bg-white/80 backdrop-blur-xl border-b border-zinc-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
      <a href="https://www.low-quality-image-maker.com" class="text-sm font-semibold tracking-tight text-zinc-800 hover:text-zinc-900 transition-colors">← Back to the image maker</a>
      <span class="text-xs text-zinc-600 font-mono uppercase tracking-wider">About</span>
    </div>
  </nav>
  <main class="max-w-3xl mx-auto px-4 sm:px-6 py-12 md:py-16">
    <h1 class="text-3xl md:text-4xl font-bold tracking-tighter text-zinc-900">About <span class="text-brand-700">Low Quality Image Maker</span></h1>

    <h2 class="mt-10 text-2xl font-bold tracking-tight text-zinc-900">Who is behind this tool?</h2>
    <p class="mt-3 text-zinc-600 leading-relaxed">
      Low Quality Image Maker is designed, built, and maintained by
      <strong class="text-zinc-800">Jiusong</strong>, a frontend developer who works with the
      <a href="https://developer.mozilla.org/en-US/docs/Web/API/Canvas_API" rel="noopener" target="_blank" class="text-brand-700 hover:text-brand-800 underline underline-offset-2">Canvas 2D API</a>
      and browser image-processing pipelines. The entire degradation engine — quality compression,
      pixelation, noise, blur, brightness shifts and every preset — is hand-written JavaScript that
      runs on your device. There is no company behind this site, no content farm, and no outsourced writing:
      the person who wrote the code also wrote the guides.
    </p>

    <h2 class="mt-10 text-2xl font-bold tracking-tight text-zinc-900">Why it exists</h2>
    <p class="mt-3 text-zinc-600 leading-relaxed">
      Existing "make image low quality" tools either upload your files to a server, cap quality control at a single slider, or bury the editor behind a signup wall.
      This tool exists to do the opposite: every image is processed locally in your browser with zero uploads, five curated meme-ready presets,
      four independent degradation parameters, and a target file size auto-match for strict upload portals. It is free forever because static hosting costs nearly nothing —
      and it stays private because your images never leave your machine.
    </p>

    <h2 class="mt-10 text-2xl font-bold tracking-tight text-zinc-900">How to contact us</h2>
    <p class="mt-3 text-zinc-600 leading-relaxed">
      Questions, bug reports, preset requests, or partnership inquiries are welcome.
      Email <a href="mailto:hello@low-quality-image-maker.com" class="text-brand-700 hover:text-brand-800 underline underline-offset-2">hello@low-quality-image-maker.com</a> —
      replies usually come within a few days. You can also find the project's development activity on
      <a href="https://github.com/jiusong" rel="noopener" target="_blank" class="text-brand-700 hover:text-brand-800 underline underline-offset-2">GitHub</a>.
      See also the <a href="/privacy/" class="text-brand-700 hover:text-brand-800 underline underline-offset-2">Privacy Policy</a>
      and <a href="/terms/" class="text-brand-700 hover:text-brand-800 underline underline-offset-2">Terms of Use</a>.
    </p>

    <div class="mt-12 rounded-2xl border border-zinc-200 bg-surface-raised p-6">
      <p class="text-sm font-semibold text-zinc-900">Jiusong</p>
      <p class="mt-1 text-sm text-zinc-600">Frontend Developer — browser-based image processing · <a href="https://github.com/jiusong" rel="noopener" target="_blank" class="text-brand-700 hover:text-brand-800 underline underline-offset-2">github.com/jiusong</a></p>
    </div>
  </main>
</BaseLayout>
