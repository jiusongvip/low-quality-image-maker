---
// Deep fry image — dedicated page for the meme-degradation intent
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCanvas from '../components/ToolCanvas.astro';

const title = 'Deep Fry Image Online - Free Low Quality Meme Maker';
const description =
  'Deep fry any image in your browser. The Classic and Nuked presets add pixelation, noise, over-brightening and 10-20% JPEG quality in one click. Free, no upload.';

const faq = [
  {
    q: 'How do I deep fry an image online?',
    a: 'Drop a JPEG, PNG, WebP, GIF or BMP into the upload zone on this page and press the Classic Deep Fried button. It sets JPEG quality to 20%, pixelation to 2x, noise to 15% and brightness to +5, then redraws the preview. Press Nuked for the harshest version at 10% quality, 8x pixelation, 35% noise and +20 brightness. Download when the preview looks bad enough.',
  },
  {
    q: 'What is the difference between Classic Deep Fried and Nuked?',
    a: 'Both use the same pipeline, only the amounts differ. Classic is the readable meme look: 20% JPEG quality, 2x pixelation, 15% noise, +5 brightness. Nuked pushes every slider further: 10% quality, 8x pixelation, 35% noise, +20 brightness, plus a warm yellow overlay blended in overlay mode. Classic keeps faces legible; Nuked is meant to look ruined.',
  },
  {
    q: 'Does deep frying reduce the resolution of my image?',
    a: 'No. The pixelation step downscales internally and then redraws at the original width and height, so the exported file keeps the same dimensions as the input. What changes is how each block of pixels is encoded, not how much screen space the image takes.',
  },
  {
    q: 'Why does a deep fried image look yellow or pink?',
    a: 'Two things push the colours that way. Raising brightness moves every pixel toward the top of its range, and any channel already near 255 clips, which shifts the hue of skin tones and highlights. On the Nuked preset a pale yellow layer is then painted over the result in overlay blend mode, so the mid tones warm up while the clipped highlights stay blown out.',
  },
  {
    q: 'Is the image uploaded to a server?',
    a: 'No. Decoding, filtering and JPEG re-encoding all run in your browser through the Canvas API, and the file is read from disk locally. You can load this page, switch your device to airplane mode, and every control on this page still works.',
  },
  {
    q: 'Can I deep fry a meme template I already have?',
    a: 'Yes, and that is the normal workflow. Download a template as PNG or JPEG, drop it here, pick a preset, then add your caption in your usual meme editor afterwards. Adding text before deep frying makes the letters artifact-heavy too, which is fine if that is the look you want.',
  },
];

const presets = [
  { name: 'Light Fry', quality: '30%', pixel: '1x', noise: '0%', brightness: '0', extra: 'No overlay' },
  { name: 'Classic Deep Fried', quality: '20%', pixel: '2x', noise: '15%', brightness: '+5', extra: 'No overlay' },
  { name: 'Nuked', quality: '10%', pixel: '8x', noise: '35%', brightness: '+20', extra: 'Warm yellow overlay' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Deep Fry Image',
      url: 'https://www.low-quality-image-maker.com/deep-fry-image/',
      applicationCategory: 'MultimediaApplication',
      operatingSystem: 'Any',
      isPartOf: { '@type': 'WebSite', name: 'Low Quality Image Maker', url: 'https://www.low-quality-image-maker.com' },
      description:
        'Browser-based deep fry tool. One-click Classic and Nuked presets apply pixelation, noise, over-brightening and heavy JPEG compression, then export at the original dimensions.',
      featureList: [
        'One-click deep fry presets with documented slider values',
        'Runs entirely in the browser, no upload',
        'Keeps original pixel dimensions while degrading',
        'Advanced controls for pixelation, noise, blur and brightness',
      ],
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.low-quality-image-maker.com/' },
        { '@type': 'ListItem', position: 2, name: 'Deep Fry Image', item: 'https://www.low-quality-image-maker.com/deep-fry-image/' },
      ],
    },
  ],
};
---

<BaseLayout {title} {description}>
  <nav class="sticky top-0 z-50 bg-white/80 backdrop-blur-xl border-b border-zinc-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
      <a href="/" class="text-sm font-semibold tracking-tight text-zinc-800 hover:text-zinc-900 transition-colors">
        Low Quality Image Maker
      </a>
      <span class="text-xs text-zinc-600 font-mono uppercase tracking-wider">Free &middot; No Upload</span>
    </div>
  </nav>

  <main class="max-w-4xl mx-auto px-4 sm:px-6 pb-16">
    <p class="pt-8 text-xs text-zinc-600">
      <a href="/" class="hover:text-zinc-900">Home</a>
      <span class="mx-1.5 text-zinc-300">&rsaquo;</span>
      <span class="text-zinc-800">Deep Fry Image</span>
    </p>

    <h1 class="mt-4 text-4xl md:text-5xl font-bold tracking-tighter text-zinc-900 leading-[1.05] text-balance">
      Deep Fry <span class="text-brand-700">Any Image</span>
    </h1>

    <p class="mt-4 text-base text-zinc-600 leading-relaxed">
      Deep frying means ruining a picture on purpose: pixelate it, add noise, push the brightness until the highlights clip, then save it as a JPEG with a very low quality setting so the blocky compression artifacts stack on top. The tool on this page does all four in one click. Pick <strong class="text-zinc-800">Classic Deep Fried</strong> for the readable Reddit-meme look, or <strong class="text-zinc-800">Nuked</strong> when you want it to look like it survived ten screenshots through a cheap phone camera.
    </p>

    <p class="mt-3 text-sm text-zinc-600 leading-relaxed">
      Everything runs in your browser through the Canvas API. The image is not uploaded anywhere, the output keeps the exact pixel dimensions you started with, and there is no watermark, account or usage limit.
    </p>

    <script is:inline>window.__pendingQuickAction = 'classic';</script>

    <section class="mt-8 rounded-2xl border border-zinc-200 bg-white p-4 sm:p-6">
      <ToolCanvas />
    </section>

    <section class="mt-12">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-zinc-900">What each preset actually sets</h2>
      <p class="mt-3 text-sm text-zinc-600 leading-relaxed">
        These are the values the buttons write into the sliders, taken from the same preset table the page ships with. After pressing one, open Advanced Controls and you will see them applied, so you can move any of them by hand.
      </p>
      <div class="mt-5 overflow-x-auto rounded-xl border border-zinc-200 bg-white">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-zinc-200 text-left text-xs uppercase tracking-wider text-zinc-500">
              <th class="px-4 py-3 font-semibold">Preset</th>
              <th class="px-4 py-3 font-semibold">JPEG quality</th>
              <th class="px-4 py-3 font-semibold">Pixelation</th>
              <th class="px-4 py-3 font-semibold">Noise</th>
              <th class="px-4 py-3 font-semibold">Brightness</th>
              <th class="px-4 py-3 font-semibold">Extra layer</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-100 text-zinc-700">
            {presets.map((p) => (
              <tr>
                <td class="px-4 py-3 font-semibold text-zinc-900 whitespace-nowrap">{p.name}</td>
                <td class="px-4 py-3 font-mono">{p.quality}</td>
                <td class="px-4 py-3 font-mono">{p.pixel}</td>
                <td class="px-4 py-3 font-mono">{p.noise}</td>
                <td class="px-4 py-3 font-mono">{p.brightness}</td>
                <td class="px-4 py-3">{p.extra}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs text-zinc-500">
        The page also has <strong class="text-zinc-700">2003 Phone</strong> and <strong class="text-zinc-700">CRT Monitor</strong> presets for the retro variants of the same idea; they are described on the <a href="/" class="text-brand-700 underline">main tool</a>.
      </p>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-zinc-900">Getting the look right</h2>
      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        <div class="rounded-xl border border-zinc-200 bg-white p-5">
          <h3 class="text-base font-semibold text-zinc-900">Start from a clean, high-contrast picture</h3>
          <p class="mt-2 text-sm text-zinc-600 leading-relaxed">
            Deep frying amplifies whatever it is given. A flat, dim photo turns into mud; a face with clear highlights and shadows turns into the glowing, crunchy look the format is about. Captions you add before degrading will get artifacts too, which some people want and others do not.
          </p>
        </div>
        <div class="rounded-xl border border-zinc-200 bg-white p-5">
          <h3 class="text-base font-semibold text-zinc-900">Quality is the artifact knob, pixelation is the block knob</h3>
          <p class="mt-2 text-sm text-zinc-600 leading-relaxed">
            Lowering JPEG quality produces the mosquito noise and coloured blocks around edges. Raising pixelation produces visible square chunks. The classic look uses both at once, which is why the preset changes quality and pixelation together instead of picking one.
          </p>
        </div>
        <div class="rounded-xl border border-zinc-200 bg-white p-5">
          <h3 class="text-base font-semibold text-zinc-900">Watch the brightness ceiling</h3>
          <p class="mt-2 text-sm text-zinc-600 leading-relaxed">
            Brightness is added per channel and clamped at 255, so once a pixel is clipped no further increase brings detail back; it only widens the blown-out area. +20 is the Nuked setting and it is already enough to lose texture in skin highlights.
          </p>
        </div>
        <div class="rounded-xl border border-zinc-200 bg-white p-5">
          <h3 class="text-base font-semibold text-zinc-900">Export as JPEG</h3>
          <p class="mt-2 text-sm text-zinc-600 leading-relaxed">
            The artifacts are part of the file, so the output format matters. JPEG is what makes them visible and permanent. PNG would keep the pixel blocks but skip the compression ringing, and WebP sits in between, so the format selector defaults to JPEG here.
          </p>
        </div>
      </div>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-zinc-900">Frequently asked questions</h2>
      <div class="mt-5 space-y-2">
        {faq.map((item) => (
          <details class="group rounded-xl border border-zinc-200 bg-white">
            <summary class="cursor-pointer list-none px-5 py-4 text-sm font-medium text-zinc-900">{item.q}</summary>
            <div class="px-5 pb-4 text-sm leading-relaxed text-zinc-600">{item.a}</div>
          </details>
        ))}
      </div>
    </section>

    <section class="mt-12 rounded-2xl border border-zinc-200 bg-white p-6">
      <h2 class="text-lg font-semibold text-zinc-900">Other things this tool does</h2>
      <p class="mt-2 text-sm text-zinc-600 leading-relaxed">
        This page is tuned for the meme look. The <a href="/#tool-root" class="text-brand-700 underline">main tool</a> exposes the same engine with a target file size field for squeezing a photo under a KB limit, plus the retro presets. Longer answers about formats, batch processing and animated GIFs are in the <a href="/#faq" class="text-brand-700 underline">homepage FAQ</a>, and <a href="/about/" class="text-brand-700 underline">who builds this</a> is on the about page.
      </p>
    </section>
  </main>

  <footer class="section-divide py-8">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-xs text-zinc-600"><span>&copy; 2026 Low Quality Image Maker</span></p>
      <div class="flex gap-6 text-xs text-zinc-600">
        <a href="/" class="hover:text-zinc-900 transition-colors">Tool</a>
        <a href="/#faq" class="hover:text-zinc-900 transition-colors">FAQ</a>
        <a href="/about/" class="hover:text-zinc-900 transition-colors">About</a>
        <a href="/privacy/" class="hover:text-zinc-900 transition-colors">Privacy</a>
        <a href="/terms/" class="hover:text-zinc-900 transition-colors">Terms</a>
      </div>
    </div>
  </footer>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>
