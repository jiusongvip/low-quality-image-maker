---
// ToolCanvas — core image degradation tool (client-side Canvas API)
// No server uploads. Everything runs in browser.
---
<div id="tool-root" class="w-full relative">
  <!-- Upload / Preview Row -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 mb-5">
    <!-- Upload Zone -->
    <div
      id="drop-zone"
      class="relative aspect-square rounded-2xl border-2 border-dashed border-zinc-300 bg-surface-raised flex flex-col items-center justify-center cursor-pointer transition-all duration-200 hover:border-brand-500/50 group"
    >
      <input
        type="file"
        id="file-input"
        accept="image/jpeg,image/png,image/webp,image/gif,image/bmp"
        multiple
        class="hidden"
      />
      <div id="upload-prompt" class="flex flex-col items-center gap-3 px-6 text-center">
        <svg class="w-10 h-10 text-zinc-500 group-hover:text-brand-500 transition-colors" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" />
        </svg>
        <div>
          <p class="text-zinc-700 font-medium text-sm">Drop image here</p>
          <p class="text-zinc-500 text-xs mt-1">or click to browse</p>
        </div>
        <p class="text-zinc-700 text-[11px]">JPEG + PNG + WebP + GIF + BMP &le;100MB</p>
      </div>
      <img id="upload-preview" class="hidden absolute inset-0 w-full h-full object-contain rounded-2xl bg-surface" alt="" />
    </div>

    <!-- Result Preview -->
    <div
      id="result-zone"
      class="relative aspect-square rounded-2xl bg-surface-raised border border-zinc-300 flex flex-col items-center justify-center overflow-hidden"
    >
      <div id="result-empty" class="flex flex-col items-center gap-2 text-zinc-700">
        <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.41a2.25 2.25 0 0 1 3.182 0l2.909 2.91m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Z" />
        </svg>
        <p class="text-xs">Processed preview</p>
      </div>
      <img id="result-image" class="hidden absolute inset-0 w-full h-full object-contain" alt="Processed result" />
      <div id="size-badge" class="hidden absolute bottom-3 right-3 bg-surface/90 backdrop-blur rounded-lg px-3 py-1.5 border border-zinc-300">
        <p class="text-xs text-zinc-700">
          <span id="orig-size" class="text-zinc-500">-</span>
          <span class="mx-1.5 text-zinc-700">&rarr;</span>
          <span id="new-size" class="text-brand-400 font-semibold">-</span>
          <span id="reduction-pct" class="ml-1 text-brand-500 text-[10px]"></span>
        </p>
        <p id="proc-time" class="hidden text-[10px] text-zinc-700 mt-0.5 text-right"></p>
      </div>
    </div>
  </div>

  <!-- Controls -->
  <div id="controls" class="space-y-4 opacity-40 pointer-events-none transition-opacity duration-300">
    <!-- Sample Images -->
    <div class="flex items-center gap-2 pb-1">
      <span class="text-[10px] text-zinc-700 uppercase tracking-wider shrink-0">Try sample:</span>
      <button data-sample="meme" class="sample-btn px-3 py-1.5 text-[11px] rounded-lg border border-zinc-300 text-zinc-500 hover:text-zinc-700 hover:border-zinc-500 transition-colors">🧨 Meme</button>
      <button data-sample="photo" class="sample-btn px-3 py-1.5 text-[11px] rounded-lg border border-zinc-300 text-zinc-500 hover:text-zinc-700 hover:border-zinc-500 transition-colors">📷 Photo</button>
      <button data-sample="screen" class="sample-btn px-3 py-1.5 text-[11px] rounded-lg border border-zinc-300 text-zinc-500 hover:text-zinc-700 hover:border-zinc-500 transition-colors">💻 Screenshot</button>
    </div>

    <!-- Quality Slider -->
    <div class="space-y-2">
      <div class="flex justify-between items-center">
        <label for="quality-slider" class="text-xs text-zinc-500 uppercase tracking-wider">Quality</label>
        <span id="quality-value" class="text-sm text-zinc-700 font-mono tabular-nums">15%</span>
      </div>
      <input
        type="range"
        id="quality-slider"
        min="1"
        max="100"
        value="15"
        class="w-full h-1.5 bg-surface-overlay rounded-full appearance-none cursor-pointer accent-brand-500 [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:w-4 [&::-webkit-slider-thumb]:h-4 [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:bg-brand-500 [&::-webkit-slider-thumb]:cursor-pointer [&::-webkit-slider-thumb]:shadow-lg"
      />
    </div>

    <!-- Preset Buttons -->
    <div class="flex flex-wrap gap-2">
      <button data-preset="mild" class="preset-btn px-3.5 py-1.5 text-xs rounded-full border border-zinc-300 text-zinc-700 hover:text-zinc-800 hover:border-zinc-600 transition-colors">Light Fry</button>
      <button data-preset="classic" class="preset-btn px-3.5 py-1.5 text-xs rounded-full border border-zinc-300 text-zinc-700 hover:text-zinc-800 hover:border-zinc-600 transition-colors">Classic Deep Fried</button>
      <button data-preset="nuked" class="preset-btn px-3.5 py-1.5 text-xs rounded-full border border-zinc-300 text-zinc-700 hover:text-zinc-800 hover:border-zinc-600 transition-colors">Nuked</button>
      <button data-preset="vintage" class="preset-btn px-3.5 py-1.5 text-xs rounded-full border border-zinc-300 text-zinc-700 hover:text-zinc-800 hover:border-zinc-600 transition-colors">2003 Phone</button>
      <button data-preset="crt" class="preset-btn px-3.5 py-1.5 text-xs rounded-full border border-zinc-300 text-zinc-700 hover:text-zinc-800 hover:border-zinc-600 transition-colors">CRT Monitor</button>
    </div>

    <!-- Advanced Toggle -->
    <button id="advanced-toggle" class="flex items-center gap-1.5 text-xs text-zinc-500 hover:text-zinc-700 transition-colors">
      <svg id="adv-chevron" class="w-3 h-3 transition-transform" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/></svg>
      <span>Advanced Controls</span>
    </button>

    <!-- Advanced Panel (collapsed by default) -->
    <div id="advanced-panel" class="hidden space-y-3 rounded-xl border border-zinc-300 bg-surface p-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div class="space-y-1.5">
          <div class="flex justify-between items-center">
            <label for="pixel-slider" class="text-[11px] text-zinc-500 uppercase tracking-wider">Pixelation</label>
            <span id="pixel-value" class="text-xs text-zinc-700 font-mono tabular-nums">1x</span>
          </div>
          <input type="range" id="pixel-slider" min="1" max="20" value="1" class="w-full h-1.5 bg-surface-overlay rounded-full appearance-none cursor-pointer accent-brand-500 [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:w-3.5 [&::-webkit-slider-thumb]:h-3.5 [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:bg-brand-500 [&::-webkit-slider-thumb]:cursor-pointer" />
        </div>
        <div class="space-y-1.5">
          <div class="flex justify-between items-center">
            <label for="noise-slider" class="text-[11px] text-zinc-500 uppercase tracking-wider">Noise</label>
            <span id="noise-value" class="text-xs text-zinc-700 font-mono tabular-nums">0%</span>
          </div>
          <input type="range" id="noise-slider" min="0" max="100" value="0" class="w-full h-1.5 bg-surface-overlay rounded-full appearance-none cursor-pointer accent-brand-500 [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:w-3.5 [&::-webkit-slider-thumb]:h-3.5 [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:bg-brand-500 [&::-webkit-slider-thumb]:cursor-pointer" />
        </div>
        <div class="space-y-1.5">
          <div class="flex justify-between items-center">
            <label for="blur-slider" class="text-[11px] text-zinc-500 uppercase tracking-wider">Blur</label>
            <span id="blur-value" class="text-xs text-zinc-700 font-mono tabular-nums">0</span>
          </div>
          <input type="range" id="blur-slider" min="0" max="20" value="0" class="w-full h-1.5 bg-surface-overlay rounded-full appearance-none cursor-pointer accent-brand-500 [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:w-3.5 [&::-webkit-slider-thumb]:h-3.5 [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:bg-brand-500 [&::-webkit-slider-thumb]:cursor-pointer" />
        </div>
        <div class="space-y-1.5">
          <div class="flex justify-between items-center">
            <label for="brightness-slider" class="text-[11px] text-zinc-500 uppercase tracking-wider">Brightness</label>
            <span id="brightness-value" class="text-xs text-zinc-700 font-mono tabular-nums">0</span>
          </div>
          <input type="range" id="brightness-slider" min="-50" max="50" value="0" class="w-full h-1.5 bg-surface-overlay rounded-full appearance-none cursor-pointer accent-brand-500 [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:w-3.5 [&::-webkit-slider-thumb]:h-3.5 [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:bg-brand-500 [&::-webkit-slider-thumb]:cursor-pointer" />
        </div>
      </div>

      <!-- Target File Size -->
      <div class="flex items-end gap-2 pt-1">
        <div class="flex-1 space-y-1.5">
          <label for="target-size-input" class="text-[11px] text-zinc-500 uppercase tracking-wider">Target File Size (KB)</label>
          <input type="number" id="target-size-input" placeholder="e.g. 50" min="1" class="w-full px-3 py-2 rounded-lg bg-surface border border-zinc-300 text-sm text-zinc-800 placeholder:text-zinc-700 focus:outline-none focus:border-brand-500/50 transition-colors [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none" />
        </div>
        <button id="target-size-apply" class="px-4 py-2 rounded-lg bg-surface-raised border border-zinc-300 text-xs text-zinc-700 hover:text-zinc-800 hover:border-zinc-600 transition-colors whitespace-nowrap">Auto-Match</button>
        <button id="target-size-clear" class="hidden px-3 py-2 rounded-lg text-xs text-zinc-700 hover:text-zinc-700 transition-colors">Clear</button>
      </div>
      <p id="target-size-status" class="hidden text-[11px] text-zinc-700"></p>

      <!-- Output Format -->
      <div class="flex items-center gap-3 pt-1">
        <span class="text-[11px] text-zinc-500 uppercase tracking-wider">Format</span>
        <div class="flex gap-1">
          <button data-format="jpeg" class="fmt-btn px-3 py-1.5 text-xs rounded-lg border border-brand-500/30 bg-brand-500/10 text-brand-400">JPEG</button>
          <button data-format="png" class="fmt-btn px-3 py-1.5 text-xs rounded-lg border border-zinc-300 text-zinc-500 hover:text-zinc-700 hover:border-zinc-600 transition-colors">PNG</button>
          <button data-format="webp" class="fmt-btn px-3 py-1.5 text-xs rounded-lg border border-zinc-300 text-zinc-500 hover:text-zinc-700 hover:border-zinc-600 transition-colors">WebP</button>
        </div>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="flex gap-3 pt-1">
      <button
        id="download-btn"
        disabled
        class="flex-1 py-2.5 rounded-xl bg-brand-500 text-white font-medium text-sm hover:bg-brand-600 active:scale-[0.98] transition-all disabled:opacity-30 disabled:cursor-not-allowed disabled:active:scale-100"
      >
        Download
      </button>
      <button
        id="copy-img-btn"
        disabled
        class="px-4 py-2.5 rounded-xl border border-zinc-300 text-zinc-700 text-sm hover:text-zinc-800 hover:border-zinc-600 transition-colors disabled:opacity-30 disabled:cursor-not-allowed"
      >
        Copy
      </button>
      <button
        id="reset-btn"
        class="px-4 py-2.5 rounded-xl border border-zinc-300 text-zinc-700 text-sm hover:text-zinc-800 hover:border-zinc-600 transition-colors"
      >
        Reset
      </button>
    </div>
  
    <!-- Batch Results -->
    <div id="batch-panel" class="hidden mt-6 pt-6 border-t border-zinc-300">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs text-zinc-500 uppercase tracking-wider">Batch results (<span id="batch-count">0</span> images)</span>
        <button id="batch-download-all" class="text-xs text-brand-400 hover:text-brand-300 transition-colors">Download All</button>
      </div>
      <div id="batch-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
      </div>
    </div>
  </div>
</div>

<script is:inline src="/js/tool.js"></script>
